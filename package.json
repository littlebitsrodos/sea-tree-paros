{
  "name": "sea-tree-paros",
  "private": true,
  "type": "module",
  "scripts": {
    "test:pwa-cache": "node scripts/check_pwa_cache_contract.mjs",
    "test:placeholders": "node scripts/check_locale_placeholder_contract.mjs",
    "test:bookings-sync": "python3 scripts/test_sync_bookings.py",
    "test:bookings-parity": "python3 scripts/test_live_bookings_parity.py",
    "test:price-parity": "node scripts/check_price_parity_contract.mjs",
    "test:schema": "node scripts/check_vacation_rental_schema_contract.mjs",
    "test:unit": "npm run test:pwa-cache && npm run test:placeholders && npm run test:bookings-sync && npm run test:bookings-parity && npm run test:price-parity && npm run test:schema",
    "preflight": "python3 scripts/build_locales.py && npm run test:unit && npm test",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:mobile": "playwright test --project=mobile",
    "test:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1"
  }
}
